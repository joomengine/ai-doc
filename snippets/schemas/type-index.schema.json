{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snippet_type canonical index",
  "type": "object",
  "propertyNames": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "name",
      "guid",
      "path",
      "settings"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "guid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "path": {
        "type": "string",
        "pattern": "^src/snippet_type/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "settings": {
        "type": "string",
        "pattern": "^src/snippet_type/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/item\\.json$"
      }
    },
    "additionalProperties": true
  }
}
