{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snippet Type classification item",
  "type": "object",
  "required": [
    "name",
    "description",
    "guid"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "additionalProperties": true
}
